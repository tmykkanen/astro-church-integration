{
	"name": "root",
	"private": true,
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"playground:dev": "pnpm --filter playground dev",
		"dev": "pnpm --filter playground dev",
		"changeset": "changeset",
		"lint": "biome check .",
		"lint:fix": "biome check --write",
		"check:globals": "node packages/astro-church/tests/checks/no-globals.mjs packages/astro-church/src",
		"verify": "pnpm lint && pnpm --filter astro-church typecheck && pnpm check:globals && pnpm --filter astro-church test && pnpm --filter playground exec astro check && node packages/astro-church/tests/build/skeleton-route.mjs",
		"test:packed": "node packages/astro-church/tests/packed/harness.mjs",
		"ci-version": "changeset version && pnpm install --no-frozen-lockfile",
		"ci-publish": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"lefthook": "2.2.2",
		"typescript": "6.0.3"
	}
}
