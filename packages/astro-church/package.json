{
	"name": "astro-church",
	"version": "0.0.0",
	"description": "Theme integration for astro church",
	"keywords": [
		"astro-integration",
		"astro-component",
		"withastro",
		"astro",
		"church"
	],
	"homepage": "https://github.com/tmykkanen/astro-church-integration#readme",
	"bugs": "https://github.com/tmykkanen/astro-church-integration/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tmykkanen/astro-church-integration.git"
	},
	"license": "MIT",
	"author": "Tyler Mykkanen",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts",
		"./content": "./src/content.ts",
		"./actions": "./src/actions.ts"
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"prepack": "pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p client && astro check --root tests/astro-check"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bible-reference-formatter": "^1.0.3",
		"bible-passage-reference-parser": "^4.0.0",
		"bible-reference-formatter": "^1.0.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"tsdown": "^0.23.5",
		"typescript": "6.0.3",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"astro": "^7.3.0",
		"typescript": ">=6"
	}
}
