{
	"name": "astro-church",
	"version": "0.0.0",
	"description": "Theme integration for astro church",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./content": "./src/content.ts",
		"./actions": "./src/actions.ts"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"files": [
		"src"
	],
	"scripts": {
		"typecheck": "tsc --noEmit && astro check --root tests/astro-check",
		"test": "vitest run"
	},
	"keywords": [
		"astro-integration",
		"astro-component",
		"withastro",
		"astro",
		"church"
	],
	"author": "Tyler Mykkanen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tmykkanen/astro-church-integration.git"
	},
	"bugs": "https://github.com/tmykkanen/astro-church-integration/issues",
	"homepage": "https://github.com/tmykkanen/astro-church-integration#readme",
	"license": "MIT",
	"dependencies": {
		"bible-passage-reference-parser": "^4.0.0",
		"bible-reference-formatter": "^1.0.1",
		"@types/bible-reference-formatter": "^1.0.3"
	},
	"peerDependencies": {
		"astro": "^7.3.0",
		"typescript": ">=6"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"typescript": "6.0.3",
		"vitest": "^4.1.12"
	}
}
